# Copia questo file in .env e inserisci la tua chiave.
# Se TYPESAFE_API_KEY è già tra le variabili d'ambiente di Windows, puoi anche lasciarla vuota qui:
# le variabili di sistema hanno la precedenza su .env.
TYPESAFE_API_KEY=

# Opzionali
# TYPESAFE_DEFAULT_MODEL=jev-latest
# PORT=3000
# DB_PATH=data/shoppal.db
